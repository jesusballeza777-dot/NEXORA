--!strict
-- Efectos visuales de NEXORA (Genesis §6, §8 y §9; Biblia p. 26, 31, 36–38 y 120).
-- Solo datos: los controladores de Client/VFX los interpretan.
--
-- Reglas que estos datos cumplen (las comprueba tests/Unit/VFXConfig.spec.luau):
-- * La identidad de cada elemento viene de la FORMA y el MOVIMIENTO (tamaño en el tiempo,
--   velocidad, aceleración, arrastre, Shape, SpreadAngle, Beam/Trail, Highlight y luz),
--   no de texturas nuevas. Solo se usan texturas del propio motor (VFX.Textures), las que
--   Roblox usa en Fire, Smoke y Sparkles. HAY QUE VERIFICARLAS EN STUDIO.
-- * Tasa máxima: 20 partículas/s por emisor (p. 26), también tras los multiplicadores.
-- * El aura no tapa la cara: nace detrás del plano de la cara (Z local < 0) o en la órbita
--   exterior. Un efecto nunca tapa al objetivo más de 0,3 s (Genesis §8).
-- * Ningún ataque supera 1,6 s; el Golpe Nexo dura como mucho 3,5 s y se puede saltar.
-- Nada aquí es un activo aprobado: son valores de partida para revisar en Studio.

local Freeze = require(script.Parent.Parent.Util.Freeze)
local Elements = require(script.Parent.Elements)

export type Key = { number } -- { tiempo 0–1, valor }
export type Range = { number } -- { mínimo, máximo }

-- Estilo de un ParticleEmitter. Los nombres de Enum se guardan como texto.
export type EmitterStyle = {
	id: string,
	texture: string, -- clave de VFX.Textures
	anchor: string, -- Back | Orbit | Ground | Top (aura) · Mouth | Caster | CasterFeet | Target | TargetFeet | Above
	rate: number, -- partículas/s del emisor continuo (≤ 20)
	tick: number?, -- emisión por pulsos: `burst` partículas cada `tick` s (en vez de `rate`)
	burst: number?, -- partículas por pulso o por brote
	lifetime: Range,
	speed: Range,
	spread: { number }, -- SpreadAngle {x, y} en grados
	-- Forma del volumen: solo actúa si el emisor cuelga de una BasePart (volúmenes de
	-- combate). En un Attachment (aura) Roblox emite desde un punto: el aura usa
	-- dispersión y órbitas en su lugar.
	shape: string?, -- Box | Sphere | Cylinder | Disc
	volume: { number }?, -- tamaño del volumen de combate (studs)
	shapeStyle: string?, -- Volume | Surface
	shapeInOut: string?, -- Outward | Inward | InAndOut
	-- Dirección relativa a la criatura (mira a +Z) o, en combate, al objetivo:
	-- Up | Down | Forward | Behind | Left | Right. El aura nunca usa Forward.
	direction: string?,
	acceleration: { number }?,
	drag: number?,
	size: { Key },
	transparency: { Key }?,
	squash: { Key }?,
	rotation: Range?,
	rotSpeed: Range?,
	orientation: string?, -- FacingCamera | FacingCameraWorldUp | VelocityParallel | VelocityPerpendicular
	lightEmission: number,
	lightInfluence: number?,
	brightness: number?,
	zOffset: number?,
	lockedToPart: boolean?,
	color: string, -- clave de la paleta del elemento o de la rareza
	colorTo: string?,
	-- Órbita del punto de emisión. plane: Horizontal (alrededor del cuerpo; no emite en el
	-- sector frontal) · Vertical (disco detrás de la cabeza) · Ground (a ras de suelo).
	orbit: { radius: number, speed: number, tilt: number?, step: number?, bob: number?, plane: string? }?,
	note: string,
}

-- Paleta por elemento: "primary" sale de Config/Elements.color (no se duplica).
local function palette(id: string, secondary: { number }, accent: { number }, dark: { number })
	return { primary = Elements.ById[id].color, secondary = secondary, accent = accent, dark = dark }
end

-- Texturas del MOTOR (rbxasset://, incluidas en el cliente de Roblox). No son IDs de
-- activos subidos: no se inventa ningún rbxassetid. Verificar en Studio que cargan.
local Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds", -- Sparkles
	Fire = "rbxasset://textures/particles/fire_main.dds", -- Fire (llama)
	Spark = "rbxasset://textures/particles/fire_sparks_main.dds", -- Fire (chispas)
	Smoke = "rbxasset://textures/particles/smoke_main.dds", -- Smoke
}

local Styles: { [string]: EmitterStyle } = {}
local function S(s: EmitterStyle)
	assert(Styles[s.id] == nil, "Estilo duplicado: " .. s.id)
	Styles[s.id] = s
end

